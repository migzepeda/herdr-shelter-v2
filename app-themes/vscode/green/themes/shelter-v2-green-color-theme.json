  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#4f8f48", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#7dff5c" } },
    { "scope": ["constant.character.escape", "string.regexp"], "settings": { "foreground": "#5fd7c8" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"], "settings": { "foreground": "#c792ea" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#f0c040" } },
    { "scope": ["keyword.operator", "punctuation.separator", "punctuation.accessor"], "settings": { "foreground": "#c3e6bc" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#70c062" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#b4ffa0" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#5fd7c8" } },
    { "scope": ["variable", "variable.other"], "settings": { "foreground": "#9cf58a" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#c3e6bc", "fontStyle": "italic" } },
    { "scope": ["variable.language", "variable.language.this"], "settings": { "foreground": "#f0c040", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key", "variable.other.object.property"], "settings": { "foreground": "#5fd7c8" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#6fa8f0" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#5fd7c8" } },
    { "scope": ["entity.name.namespace", "entity.name.module"], "settings": { "foreground": "#b4ffa0" } },
    { "scope": ["meta.decorator", "punctuation.decorator", "storage.type.annotation"], "settings": { "foreground": "#c792ea" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#f06050" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#8cff6e", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#b4ffa0", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#b4ffa0" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#5fd7c8" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#70c062", "fontStyle": "italic" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#7dff5c" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#f06050" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#f0c040" } },
    { "scope": ["support.type.property-name.json"], "settings": { "foreground": "#5fd7c8" } }
  ],
  "semanticTokenColors": {
    "parameter": { "foreground": "#c3e6bc", "italic": true },
    "property": "#5fd7c8",
    "enumMember": "#c792ea",
    "type": "#5fd7c8",
    "class": "#5fd7c8",
    "interface": "#5fd7c8",
    "namespace": "#b4ffa0",
    "function": "#b4ffa0",
    "method": "#b4ffa0",
    "decorator": "#c792ea",
    "*.deprecated": { "strikethrough": true }
  }
}
