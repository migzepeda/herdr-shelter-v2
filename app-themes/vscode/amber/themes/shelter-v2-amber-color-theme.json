  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#9a8063", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#c0d498" } },
    { "scope": ["constant.character.escape", "string.regexp"], "settings": { "foreground": "#78b5a8" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"], "settings": { "foreground": "#b896c0" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#ecc27a" } },
    { "scope": ["keyword.operator", "punctuation.separator", "punctuation.accessor"], "settings": { "foreground": "#d9b98a" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#a8896a" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#e8cfa6" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#78b5a8" } },
    { "scope": ["variable", "variable.other"], "settings": { "foreground": "#d9b98a" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#d9b98a", "fontStyle": "italic" } },
    { "scope": ["variable.language", "variable.language.this"], "settings": { "foreground": "#ecc27a", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key", "variable.other.object.property"], "settings": { "foreground": "#78b5a8" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#7fa0c4" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#78b5a8" } },
    { "scope": ["entity.name.namespace", "entity.name.module"], "settings": { "foreground": "#e8cfa6" } },
    { "scope": ["meta.decorator", "punctuation.decorator", "storage.type.annotation"], "settings": { "foreground": "#b896c0" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#d9806a" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#e0a458", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#e8cfa6", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#e8cfa6" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#78b5a8" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#a8896a", "fontStyle": "italic" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#c0d498" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#d9806a" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#ecc27a" } },
    { "scope": ["support.type.property-name.json"], "settings": { "foreground": "#78b5a8" } }
  ],
  "semanticTokenColors": {
    "parameter": { "foreground": "#d9b98a", "italic": true },
    "property": "#78b5a8",
    "enumMember": "#b896c0",
    "type": "#78b5a8",
    "class": "#78b5a8",
    "interface": "#78b5a8",
    "namespace": "#e8cfa6",
    "function": "#e8cfa6",
    "method": "#e8cfa6",
    "decorator": "#b896c0",
    "*.deprecated": { "strikethrough": true }
  }
}
