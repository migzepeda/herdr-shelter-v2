  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#7a8c78", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#a8d49e" } },
    { "scope": ["constant.character.escape", "string.regexp"], "settings": { "foreground": "#78bfb2" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"], "settings": { "foreground": "#b69ad0" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#d4b05a" } },
    { "scope": ["keyword.operator", "punctuation.separator", "punctuation.accessor"], "settings": { "foreground": "#b8c9b4" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#8a9c88" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#c4d4c0" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#78bfb2" } },
    { "scope": ["variable", "variable.other"], "settings": { "foreground": "#b8c9b4" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#b8c9b4", "fontStyle": "italic" } },
    { "scope": ["variable.language", "variable.language.this"], "settings": { "foreground": "#d4b05a", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key", "variable.other.object.property"], "settings": { "foreground": "#78bfb2" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#7fa6d0" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#78bfb2" } },
    { "scope": ["entity.name.namespace", "entity.name.module"], "settings": { "foreground": "#c4d4c0" } },
    { "scope": ["meta.decorator", "punctuation.decorator", "storage.type.annotation"], "settings": { "foreground": "#b69ad0" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#d97a68" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#8fbf86", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#c4d4c0", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#c4d4c0" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#78bfb2" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#8a9c88", "fontStyle": "italic" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#a8d49e" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#d97a68" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#d4b05a" } },
    { "scope": ["support.type.property-name.json"], "settings": { "foreground": "#78bfb2" } }
  ],
  "semanticTokenColors": {
    "parameter": { "foreground": "#b8c9b4", "italic": true },
    "property": "#78bfb2",
    "enumMember": "#b69ad0",
    "type": "#78bfb2",
    "class": "#78bfb2",
    "interface": "#78bfb2",
    "namespace": "#c4d4c0",
    "function": "#c4d4c0",
    "method": "#c4d4c0",
    "decorator": "#b69ad0",
    "*.deprecated": { "strikethrough": true }
  }
}
